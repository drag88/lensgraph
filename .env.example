# Copy to .env and fill in. Never commit .env.
# See docs/decisions/004-model-selection.md (v3) for the candidate set and selection rule.
# All generator/judge candidates run through DeepInfra; only ANTHROPIC and OPENAI keys are
# needed for the one-off premium triangulation run, and they are optional.

# Open-weight hosted inference — primary
DEEPINFRA_API_KEY=        # gemma-4-31b | qwen3-235b-a22b-instruct | deepseek-v3.2

# Optional failover router (wire when DeepInfra has an outage)
OPENROUTER_API_KEY=       # ~5% markup but unified billing + automatic failover

# Embeddings (optional — only if local BGE-M3 fails the embeddings minimum)
VOYAGE_API_KEY=           # voyage-3-large fallback
GEMINI_API_KEY=           # gemini-embedding-2 fallback / visual-retrieval baseline

# Premium triangulation (optional, one-off on test_gold for the writeup)
ANTHROPIC_API_KEY=        # claude-sonnet-4-6
OPENAI_API_KEY=           # gpt-5.5

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Data sources (v1)
YOUTUBE_API_KEY=
