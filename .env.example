# Copy to .env and fill in. Never commit .env.
# See docs/decisions/004-model-selection.md for which provider runs which component.

# Open-weight hosted inference (default generator + judge)
DEEPINFRA_API_KEY=        # gemma-4-31b (generator) + deepseek-v3 (judge)

# Embeddings
VOYAGE_API_KEY=           # voyage-3-large (no competitive open-weight replacement)

# Premium triangulation (optional, runs once on test_gold for the writeup comparison)
ANTHROPIC_API_KEY=        # claude-sonnet-4-6, one-off comparison run

# Optional ad-hoc spot-checks
OPENAI_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Data sources (v1)
YOUTUBE_API_KEY=
