# Per docs/phase-1-design.md §7: pgvector base + apt-installed pgmq is the
# preferred path, but postgresql-16-pgmq is not published on PGDG apt for
# arm64 — the documented fallback fires. Tembo's image bundles pgmq; we
# layer pgvector via PGDG apt on top.
FROM quay.io/tembo/pg17-pgmq:latest

USER root

RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-17-pgvector \
 && rm -rf /var/lib/apt/lists/*

USER postgres
