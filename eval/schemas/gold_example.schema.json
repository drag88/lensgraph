{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lensgraph.dev/schemas/gold_example.schema.json",
  "title": "LensGraph Gold Example",
  "description": "Eval ground truth. Provenance lives on talks (see talk.schema.json), not on examples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "split",
    "question_type",
    "modality",
    "difficulty",
    "verified",
    "curator",
    "curated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Stable kebab/snake-case ID. Used to join with eval results."
    },
    "question": { "type": "string", "minLength": 15 },
    "video_id": {
      "type": "string",
      "description": "Required for single_clip and negative+scope=video. Forbidden for synthesis and negative+scope=corpus."
    },
    "talk_title": { "type": "string" },
    "split": { "enum": ["dev", "test"] },
    "question_type": { "enum": ["single_clip", "synthesis", "negative"] },
    "negative_scope": {
      "enum": ["video", "corpus"],
      "description": "Required when question_type=negative. corpus=no video in the corpus answers it (primary abstention signal). video=this video does not but corpus might."
    },
    "gold_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_sec", "end_sec"],
        "properties": {
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "minimum": 0 },
          "video_id": { "type": "string" }
        }
      }
    },
    "expected_answer": {
      "type": ["string", "null"],
      "description": "Free-form reference answer for human inspection. Not consumed by the judge."
    },
    "expected_claims": {
      "type": "array",
      "items": { "type": "string", "minLength": 10 },
      "description": "Atomic claims the answer must contain. Faithfulness judge scores claim-by-claim."
    },
    "abstention_expected": { "type": "boolean", "default": false },
    "modality": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "transcript",
          "slide",
          "screen_code",
          "diagram",
          "whiteboard",
          "audio_only"
        ]
      }
    },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "curator": { "type": "string", "minLength": 1 },
    "curated_at": { "type": "string", "format": "date-time" },
    "verified": {
      "type": "boolean",
      "description": "Validator rejects unverified examples committed to corpora files."
    },
    "curation_source_version": {
      "type": "string",
      "description": "git SHA of curation tooling used to draft this example."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "question_type": { "const": "single_clip" } },
        "required": ["question_type"]
      },
      "then": {
        "required": ["video_id", "gold_spans", "expected_claims"],
        "properties": {
          "gold_spans": { "minItems": 1, "maxItems": 1 },
          "abstention_expected": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": { "question_type": { "const": "synthesis" } },
        "required": ["question_type"]
      },
      "then": {
        "required": ["gold_spans", "expected_claims"],
        "not": { "required": ["video_id"] },
        "properties": {
          "gold_spans": {
            "minItems": 2,
            "items": { "required": ["start_sec", "end_sec", "video_id"] }
          },
          "abstention_expected": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": { "question_type": { "const": "negative" } },
        "required": ["question_type"]
      },
      "then": {
        "required": ["negative_scope"],
        "properties": {
          "gold_spans": { "maxItems": 0 },
          "abstention_expected": { "const": true },
          "expected_answer": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "question_type": { "const": "negative" } }, "required": ["question_type"] },
          { "properties": { "negative_scope": { "const": "video" } }, "required": ["negative_scope"] }
        ]
      },
      "then": { "required": ["video_id"] }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "question_type": { "const": "negative" } }, "required": ["question_type"] },
          { "properties": { "negative_scope": { "const": "corpus" } }, "required": ["negative_scope"] }
        ]
      },
      "then": { "not": { "required": ["video_id"] } }
    }
  ]
}
